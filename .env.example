# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only used by `npm run seed` (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud → Maps JavaScript API key (restrict it to your domains)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Public URL used in magic-link emails (e.g. https://crlibraries.ca). Falls back to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Moderation emails (optional) ──
# RESEND_API_KEY is added automatically by the Vercel Resend integration.
RESEND_API_KEY=
# Verified sender; Resend's shared sender only delivers to your own account email.
RESEND_FROM=CR Little Libraries <onboarding@resend.dev>
# Where submission alerts go (comma-separated for several moderators)
MODERATOR_EMAIL=
# Shared secret checked on the Supabase webhook -> /api/notify
NOTIFY_SECRET=
# Signs the approve/reject links in those emails (32+ random characters)
REVIEW_TOKEN_SECRET=
